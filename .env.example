# M1 server configuration contract; upload validation makes no provider calls.
# Values are selected and validated by src/config. The approved numeric policies default below.
# Never use NEXT_PUBLIC for credentials or commit real keys/local environment files.
AI_PROVIDER=gemini
# Select a suitable current model during implementation; no model is assumed here.
AI_MODEL=
AI_API_KEY=

# Approved product maximum: 10 MB per file. Centralize the byte conversion in code.
MAX_UPLOAD_SIZE_MB=10
# Approved maximum for transient provider/network failures only.
AI_MAX_AUTOMATIC_RETRIES=1

# Set/derive centralized values for the configured model; blanks are not defaults.
AI_TIMEOUT_MS=
AI_CONTEXT_TOKEN_LIMIT=
