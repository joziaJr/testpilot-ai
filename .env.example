# M3 server configuration contract. Gemini calls are server-side only.
# Values are selected and validated by src/config. Never commit a real key.
# Never use NEXT_PUBLIC for credentials or commit real keys/local environment files.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash
AI_API_KEY=

# Approved product maximum: 10 MB per file. Centralize the byte conversion in code.
MAX_UPLOAD_SIZE_MB=10
# Approved maximum for transient provider/network failures only.
AI_MAX_AUTOMATIC_RETRIES=1

# Centralized provider deadline and conservative input-token ceiling.
AI_TIMEOUT_MS=60000
AI_CONTEXT_TOKEN_LIMIT=900000
# Deterministic fake provider for automated tests only; production rejects true.
AI_TEST_MODE=false
