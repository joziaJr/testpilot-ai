{
  "name": "testpilot-ai",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Documentation-first AI QA test case generator foundation.",
  "engines": {
    "node": ">=22.22.1"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ai-eval": "vitest run src/lib/analysis/ai-evaluation.test.ts src/lib/generation/generation-evaluation.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,tsx}": [
      "node node_modules/eslint/bin/eslint.js --max-warnings=0 --no-warn-ignored",
      "node node_modules/prettier/bin/prettier.cjs --check"
    ],
    "*.{css,json,yml,yaml}": "node node_modules/prettier/bin/prettier.cjs --check"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "mammoth": "1.11.0",
    "next": "16.3.5",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "prettier": "3.9.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
